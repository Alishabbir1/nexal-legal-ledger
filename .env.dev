# Nexal Legal Ledger — local development environment
#
# Copy this file to .env and set NEXAL_DEV=1 before starting the dev server.
# This file is intentionally NOT gitignored so it can serve as documentation.
# Your actual .env file (with secrets) should remain gitignored.
#
# ── REQUIRED FOR LOCAL DEV ────────────────────────────────────────────────────
#
# Enables the /dev/login route and routes all unauthenticated requests to the
# local login page instead of the Vercel Portal.
NEXAL_DEV=1

# ── DATA DIRECTORY ────────────────────────────────────────────────────────────
#
# When NEXAL_DEV=1 the data root defaults to <project>/data/ automatically.
# Override here if you want a custom path:
# NEXAL_DATA_DIR=C:\solicitor-web-sandbox\data

# ── FLASK SECRET KEY ─────────────────────────────────────────────────────────
#
# Used for session signing. In dev the default is fine; do not use in production.
# FLASK_SECRET_KEY=dev-only-change-me

# ── SSO (NOT NEEDED FOR LOCAL DEV) ───────────────────────────────────────────
#
# When NEXAL_DEV=1 the /dev/login page is used — no Portal SSO required.
# The default dev SSO secret below is already baked into sso_auth.py.
# SSO_SECRET_KEY=nexal-legal-dev-secret-change-in-production-2026

# ── PORTAL URL (optional — shown in error pages only in dev) ─────────────────
# NEXAL_PORTAL_URL=https://nexal-legal.vercel.app

# ── DO NOT SET IN LOCAL DEV ───────────────────────────────────────────────────
# NEXAL_PRODUCTION must NOT be set; it activates production-only guards that
# reject dev secrets and refuse to start without a full production configuration.
# NEXAL_PRODUCTION=true   <-- DO NOT set this locally
